# =====================================================================
# Exemplo de variáveis de ambiente.
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA envie o .env para o Git (ele está no .gitignore).
# =====================================================================

# ----- Supabase (usado pelo cliente no browser) -----------------------
# Este projeto NÃO usa bundler (Vite/Next/etc.),
# por isso NÃO usa prefixo VITE_ ou NEXT_PUBLIC_.
# O server.js le estas variaveis (dotenv) e as injeta para o navegador
# no endpoint /env-config.js. O supabaseClient.js consome delas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# ----- MySQL (backend Express - opcional / legado) --------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=auth_db

# ----- Configuração do servidor ----------------------------------------
PORT=3000